filters:
  and:
    - file.folder == "blog"
    - file.name != "index"
formulas:
  post: 'link(file.path, title)'
  when: 'date.format("MMM D, YYYY")'
properties:
  formula.post:
    displayName: " "
  formula.when:
    displayName: " "
views:
  - type: cards
    name: Latest
    limit: 3
    sort:
      - property: date
        direction: DESC
    order:
      - formula.when
      - formula.post
      - description
